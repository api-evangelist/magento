      "name": "Shipments",
      "description": {
        "content": "Shipment management for orders including shipment creation, retrieval, tracking number management, and shipment comments.",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "56b7aba9-8e39-4c03-aba5-a1ee10f940de",
          "name": "Create a shipment",
          "request": {
            "name": "Create a shipment",
            "description": {
              "content": "Creates a new shipment record for an order. The request must include the order_id and the items being shipped with their quantities. Tracking information such as carrier code, title, and tracking number can be included at creation time. An optional shipment comment can also be provided.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "V1",
                "shipment"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "description": "The hostname of your Adobe Commerce store",
                  "type": "any",
                  "value": "{{store_domain}}",
                  "key": "store_domain"
                },
                {
                  "description": "Store code followed by API version. Use \"all\" as store code for admin-scope operations, or the specific store view code for store-scoped operations. The V1 version path segment follows.",
                  "type": "any",
                  "value": "{{store_code}}",
                  "key": "store_code"
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"entity\": {\n    \"entity_id\": \"<integer>\",\n    \"order_id\": \"<integer>\",\n    \"increment_id\": \"<string>\",\n    \"created_at\": \"<dateTime>\",\n    \"tracks\": [\n      {\n        \"carrier_code\": \"<string>\",\n        \"title\": \"<string>\",\n        \"track_number\": \"<string>\"\n      },\n      {\n        \"carrier_code\": \"<string>\",\n        \"title\": \"<string>\",\n        \"track_number\": \"<string>\"\n      }\n    ]\n  }\n}",
