          "name": "List store configurations",
          "request": {
            "name": "List store configurations",
            "description": {
              "content": "Returns configuration data for all store views accessible to the authenticated user. Each store config entry includes the store code, base URLs, locale, timezone, currency codes, and weight unit settings. No authentication is required for this endpoint on most store configurations.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "V1",
                "store",
                "storeConfigs"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "description": "The hostname of your Adobe Commerce store",
                  "type": "any",
                  "value": "{{store_domain}}",
                  "key": "store_domain"
                },
                {
                  "description": "Store code followed by API version. Use \"all\" as store code for admin-scope operations, or the specific store view code for store-scoped operations. The V1 version path segment follows.",
                  "type": "any",
                  "value": "{{store_code}}",
                  "key": "store_code"
                }
              ]
            },
