          "name": "Create a guest cart",
          "request": {
            "name": "Create a guest cart",
            "description": {
              "content": "Creates a new empty shopping cart for a guest (unauthenticated) shopper. Returns a masked cart ID string that is used in subsequent guest cart operations. No authentication is required for this endpoint. The masked ID is a UUID-like string that does not expose internal database IDs.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "V1",
                "guest-carts"
