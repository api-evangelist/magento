          "name": "Create a cart for the authenticated customer",
          "request": {
            "name": "Create a cart for the authenticated customer",
            "description": {
              "content": "Creates a new empty shopping cart (quote) for the currently authenticated customer. Returns the cart ID (quote ID) that is used in subsequent cart operations. A customer can only have one active cart at a time; if an active cart already exists, its ID is returned.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "V1",
                "carts",
                "mine"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "description": "The hostname of your Adobe Commerce store",
                  "type": "any",
                  "value": "{{store_domain}}",
                  "key": "store_domain"
                },
                {
                  "description": "Store code followed by API version. Use \"all\" as store code for admin-scope operations, or the specific store view code for store-scoped operations. The V1 version path segment follows.",
                  "type": "any",
                  "value": "{{store_code}}",
                  "key": "store_code"
